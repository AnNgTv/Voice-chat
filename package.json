{
  "name": "discord-stats-bot",
  "version": "1.0.0",
  "description": "A Discord.js v14 bot that tracks message and voice activity stats per user/guild.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
  "start": "node src/deploy-commands.js && node src/index.js",
  "dev": "node --watch src/index.js",
  "migrate": "node src/database/migrate.js",
  "deploy-commands": "node src/deploy-commands.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  },
  "license": "MIT"
}
